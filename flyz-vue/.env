# 所有情况下都会加载的环境变量,注意JS引用时，自定义的这写变量都是String格式

# 公共基础路径,打包后文件的路径由绝对路径改为相对路径(不要动这个，部署有问题时修改nginx的配置)
VITE_BASE_PATH = /

# 项目本地运行端口号
VITE_PORT = 3000

# 接口请求超时配置
VITE_TIMEOUT = 60000

# WebSocket 心跳配置
VITE_WS_HEARTBEAT_OUTGOING = 10000
VITE_WS_HEARTBEAT_INCOMING = 10000

# 系统是否需要登录
VITE_NEEDLOGIN = false

# 是否启用 mockjs 模拟接口
VITE_USE_MOCK = false

# 登录页"服务地址"下拉/配置列表，JSON 数组字符串
# 每个元素字段：key=唯一标识/存储键，label=表单显示名，defaultValue=默认URL，placeholder=输入框占位符
# 开发环境可额外配置 proxyTarget 字段，Vite dev server 会据此自动生成代理（见 .env.development）
VITE_SERVER_LIST = [{"key":"javaBaseUrl","label":"Java 服务地址","defaultValue":"","placeholder":"http://ip:port/japi"},{"key":"pythonBaseUrl","label":"代理服务地址","defaultValue":"","placeholder":"http://ip:port/papi"}]
