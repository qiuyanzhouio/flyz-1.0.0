# 说明：npm run dev 会加载.env和.env.development 内的配置

# 开发环境基础路径
VITE_BASE_PATH = /

# 开发环境 - 服务地址列表
# defaultValue: 默认服务地址（相对路径走 Vite 代理，绝对地址直连后端）
# proxyTarget: 开发代理目标地址（Vite dev server 使用），仅开发环境需要配置
VITE_SERVER_LIST = [{"key":"javaBaseUrl","label":"Java 服务地址","defaultValue":"/japi","proxyTarget":"http://127.0.0.1:8000/api/v1","placeholder":"http://ip:port/japi"},{"key":"pythonBaseUrl","label":"代理服务地址","defaultValue":"/papi","proxyTarget":"http://127.0.0.1:8000/api/v1","placeholder":"http://ip:port/papi"}]
